# Somente variáveis de servidor na Vercel. Nunca copiar para config.js.
FAROL_GOOGLE_ENABLED=false
FAROL_ORIGIN=https://farolge.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave AES-256: 32 bytes aleatórios em base64, gerada em ambiente seguro.
FAROL_TOKEN_KEY=
# SOMENTE o Supabase exclusivo do FAROL GE.
FAROL_SUPABASE_URL=
FAROL_SUPABASE_SERVICE_ROLE_KEY=
# Endereço real da caixa geral e lista de participantes autorizados do piloto.
FAROL_GENERAL_EMAIL=
FAROL_ALLOWED_PERSONAL_EMAILS=
